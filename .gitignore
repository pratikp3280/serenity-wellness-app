
# Node.js dependencies
**/node_modules/

# Production build files
**/dist/
**/dist-ssr/

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example

# Debug logs
**/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp


# Exclude unrelated Word documents
/Frontend/public/images/182_Camera Ready_SEATNGA_1.(3).docx
/Frontend/public/images/before.docx



# ==========================================
# Serenity - Backend and project exclusions
# ==========================================

# Exclude all Postman folders at every level
**/postman/
**/.postman/

# Maven generated build output
**/target/

# Eclipse workspace/project metadata
**/.settings/
**/.classpath
**/.project

# Exclude accidental root-level npm lockfile
/package-lock.json

# Exclude exported UI audit archive
/Frontend/serenity-ui-audit-round1.zip
